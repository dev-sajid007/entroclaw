# Model
OPENAI_API_KEY=
MODEL=gpt-4.1-mini
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint

# Workspace the agent may access (defaults to the current directory)
WORKSPACE=

# Limits and safety
MAX_TOOL_OUTPUT=20000
COMMAND_TIMEOUT=30
REQUIRE_APPROVAL=true
MAX_ITERATIONS=25

# Context management: older turns are summarized when the conversation exceeds the limit
CONTEXT_TOKEN_LIMIT=100000
CONTEXT_KEEP_TOKENS=30000

# Server
HOST=127.0.0.1
PORT=8765
# AGENT_API_TOKEN=            # require "Authorization: Bearer <token>" on every request

# Persistence and integrations
# STATE_DIR=                  # checkpoints, memory, undo snapshots; default ~/.local/state/coding-agent
# CHECKPOINT_PATH=            # defaults to $STATE_DIR/checkpoints.sqlite
# MCP_CONFIG=mcp.json         # see mcp.example.json
LOG_LEVEL=INFO
