# Models: "provider:model". Set the key for each provider you use.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
MODEL=openai:gpt-4.1-mini
# MODELS=anthropic:claude-opus-5-5,openai:gpt-4.1-mini   # extra models offered by /model
# MODEL_EFFORT=high           # Claude effort: low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=default # server-side refusal fallback for Claude; "off" to disable
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint

# Workspace the agent may access (defaults to the current directory)
WORKSPACE=

# Shell sandbox (bubblewrap): auto | bwrap | off. No network inside unless SANDBOX_NETWORK=true.
SANDBOX=auto
SANDBOX_NETWORK=false

# Web tools: fetch_url is always available (with approval); web_search needs one of these keys.
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# WEB_ALLOW_PRIVATE=false     # allow fetching private/local network addresses

# Limits and safety
MAX_TOOL_OUTPUT=20000
COMMAND_TIMEOUT=30
REQUIRE_APPROVAL=true
MAX_ITERATIONS=25

# Context management: older turns are summarized when the conversation exceeds the limit
CONTEXT_TOKEN_LIMIT=100000
CONTEXT_KEEP_TOKENS=30000

# Server
HOST=127.0.0.1
PORT=8765
# AGENT_API_TOKEN=            # require "Authorization: Bearer <token>" on every request

# Persistence and integrations
# STATE_DIR=                  # checkpoints, memory, undo snapshots; default ~/.local/state/entroclaw
# CHECKPOINT_PATH=            # defaults to $STATE_DIR/checkpoints.sqlite
# MCP_CONFIG=mcp.json         # see mcp.example.json
LOG_LEVEL=INFO
